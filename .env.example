# Copy to .env and supply real values outside source control.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/civiclens
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-server-secret
REDIS_URL=redis://localhost:6379/0
POTHOLE_MODEL_PATH=ml/weights/yolo26_best.pt
# Long random server-side bearer token. Never expose it in the frontend.
CIVICLENS_OPERATOR_TOKEN=replace-with-long-random-token
# Shared Redis fixed-window limits. These are intentionally adjustable v1 defaults.
CIVICLENS_REPORT_RATE_LIMIT=20
CIVICLENS_REPORT_RATE_WINDOW_SECONDS=60
CIVICLENS_OPERATOR_RATE_LIMIT=60
CIVICLENS_OPERATOR_RATE_WINDOW_SECONDS=60
